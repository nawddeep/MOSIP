{
  // Run and Debug (F5) -> "MiniFASNet demo dashboard": starts the server with the project's .venv Python and opens the page.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MiniFASNet demo dashboard",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/minifasnet/dashboard/server.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": ["--port", "8765"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": { "pattern": "(http://127\\.0\\.0\\.1:[0-9]+)", "uriFormat": "%s", "action": "openExternally" }
    }
  ]
}
