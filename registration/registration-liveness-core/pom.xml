<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.mosip.registration</groupId>
		<artifactId>registration-client-parent</artifactId>
		<version>1.2.0.2</version>
	</parent>

	<groupId>io.mosip.registration</groupId>
	<artifactId>registration-liveness-core</artifactId>
	<version>1.2.0.2</version>
	<name>registration-liveness-core</name>
	<description>Platform-neutral face liveness engine and MiniFASNet PAD (plain Java 11). Same sources as the Android client; see sync-from-android.sh.</description>

	<properties>
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Same ONNX Runtime family as the Android client (1.19.2). MIT licence. -->
		<onnxruntime.version>1.19.2</onnxruntime.version>
		<!-- Apache-2.0 -->
		<liveness.gson.version>2.10.1</liveness.gson.version>
		<liveness.junit5.version>5.6.2</liveness.junit5.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.microsoft.onnxruntime</groupId>
			<artifactId>onnxruntime</artifactId>
			<version>${onnxruntime.version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>${liveness.gson.version}</version>
		</dependency>

		<!-- Tests: the copied suites mix JUnit 4 and JUnit 5. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${liveness.junit5.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.vintage</groupId>
			<artifactId>junit-vintage-engine</artifactId>
			<version>${liveness.junit5.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven.surefire.plugin.version}</version>
				<configuration>
					<!-- Test paths are relative to this module. Model files are the bundled resources. -->
					<workingDirectory>${project.basedir}</workingDirectory>
					<systemPropertyVariables>
						<modelDir>${project.basedir}/src/main/resources/liveness/models/minifasnet</modelDir>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
